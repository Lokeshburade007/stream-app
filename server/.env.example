# Optional: free TMDB developer credential. Enables live Indian and Netflix-in-India
# movie/series guide rows. Keep this server-side; never expose it as NEXT_PUBLIC_*.
TMDB_API_KEY=

# Defaults used when omitted.
TVMAZE_COUNTRY=IN
CATALOG_TIME_ZONE=Asia/Kolkata

# Personal VPS library. `buradepiyush@gmail.com` is the fixed administrator:
# it alone can delete videos and choose whether signed-in members may upload.
# The complete HLS package and temporary source share this total server budget.
VIDEO_STORAGE_QUOTA_GB=20
# Individual source uploads and direct URL imports are capped at 10 GB when
# the 20 GB library is empty; the server reserves 10 GB for HLS generation.

# Never enable this on an Internet-facing server. Quick access can only create
# non-admin demo accounts when explicitly enabled for local development.
ALLOW_QUICK_ACCESS=false

# SecurePool OTP email delivery. For Gmail, use an App Password (not your
# normal account password) after enabling two-step verification.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your_16_character_google_app_password
SMTP_FROM="StreamHub <you@gmail.com>"

# Uploads are encoded into source-aware 360p, 720p, 1080p, and (for genuine
# 4K sources) 2160p HLS variants in server/media/hls. Smaller inputs are not
# upscaled and labelled as 4K.
# The bundled FFmpeg/FFprobe installers are used automatically when system binaries
# are unavailable.
