# Optional: free TMDB developer credential. Enables live Indian and Netflix-in-India
# movie/series guide rows. Keep this server-side; never expose it as NEXT_PUBLIC_*.
TMDB_API_KEY=

# Defaults used when omitted.
TVMAZE_COUNTRY=IN
CATALOG_TIME_ZONE=Asia/Kolkata

# Uploads are encoded into 360p, 720p, and 1080p HLS variants in server/media/hls.
# The bundled FFmpeg/FFprobe installers are used automatically when system binaries
# are unavailable.
